{
  "name": "kcode-bytes",
  "id_prefix": "b",
  "scope": "kcode -e and -c on stdin of 0-700 bytes (random bytes and long runs)",
  "seed": 7,
  "template": {
    "args": [
      "{mode}"
    ],
    "stdin_hex": "{data}"
  },
  "defaults": {
    "mode": "-e",
    "data": ""
  },
  "factors": {
    "mode": [
      "-e",
      "-c"
    ],
    "data": [
      "",
      "00",
      "ff",
      "",
      "",
      "",
      "0d0a",
      "0a0a0a"
    ]
  },
  "combine": "full",
  "fields": {
    "mode": {
      "type": "choice",
      "values": [
        "-e",
        "-c"
      ]
    },
    "data": {
      "type": "bytes_hex",
      "min_len": 0,
      "max_len": 700,
      "runs": true,
      "max_run": 300,
      "byte_pool": [
        0,
        1,
        10,
        13,
        65,
        66,
        127,
        128,
        255
      ]
    }
  },
  "boundaries": false,
  "random": 1500,
  "untested": [
    "inputs over 1 MiB (the original reads at most 1 MiB; behaviour past it not probed)",
    "stdin closed early / pipes that fail",
    "locale or terminal settings"
  ]
}