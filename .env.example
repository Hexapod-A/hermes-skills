# hermes-skills: copy the variables you use into ~/.hermes/.env (never commit real values).
# Then list them under terminal.env_passthrough in ~/.hermes/config.yaml so skill scripts can read them.

# ---- web-research (optional; any ONE search backend is enough, otherwise DuckDuckGo HTML is used) ----
SEARXNG_URL=
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# ---- lead-gen (OpenStreetMap asks for a contact in the user agent) ----
OSM_USER_AGENT="3xagentic-leads (you@example.com)"
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# ---- flyer-studio / docs-and-pdfs (optional: keep brand kits outside the repo) ----
# FLYER_BRANDS_DIR=/home/you/brands

# ---- video-clipper (optional: faster Whisper model downloads from Hugging Face) ----
# HF_TOKEN=

# ---- maps-lead-gen (all optional; each key only switches on its own step) ----
# Owner finder LLM: any OpenAI-compatible endpoint (OpenRouter, Nous Portal, OpenAI, DeepSeek, local Ollama) ...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ... or one of these instead
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Paid Maps data sources (free default is OpenStreetMap)
MAPSDATA_API_KEY=
GOOGLE_PLACES_API_KEY=
# SERPER_API_KEY is shared with web-research (above)
RAPIDAPI_KEY=
# RAPIDAPI_MAPS_HOST=local-business-data.p.rapidapi.com
# Email waterfall + verification
PROSPEO_API_KEY=
ICYPEAS_API_KEY=
MILLIONVERIFIER_API_KEY=
BOUNCEBAN_API_KEY=
# Draft signature + CAN-SPAM footer (your real postal address)
SENDER_NAME=John
SENDER_COMPANY=3xAgentic
SENDER_ADDRESS=

# ---- tutorial-video-studio (voice clone + narration; one of the two is enough) ----
ELEVENLABS_API_KEY=
# FAL_KEY=   # fallback clone-capable voice model (MiniMax on fal.ai)
